NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# ---- Email (Brevo) and scheduler ----
# Leave these empty to keep email switched off (nothing is sent).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
BREVO_API_KEY=your-brevo-api-key

# Sender address must be verified in Brevo (Senders & IP / Domains).
EMAIL_FROM=volunteers@your-verified-domain.com
EMAIL_FROM_NAME=Gala Volunteers

# Live site address, no trailing slash. Used for the links inside emails.
SITE_URL=https://your-site.netlify.app

# Long random string. Must match the x-cron-secret header in supabase/setup/email-cron.sql.
CRON_SECRET=replace-with-a-long-random-string
